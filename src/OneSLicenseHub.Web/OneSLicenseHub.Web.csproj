<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <RootNamespace>OneSLicenseHub.Web</RootNamespace>
    <AssemblyName>OneSLicenseHub.Web</AssemblyName>
    <Title>1С: License Hub</Title>
    <Product>1С: License Hub</Product>
    <Description>1С: License Hub — Мониторинг USB-ключей AnywhereUSB, распознавание СЛК, Guardant и Sentinel</Description>
    <AssemblyTitle>1С: License Hub</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OneSLicenseHub.Core\OneSLicenseHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="icon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Include="INSTALL_SERVICE.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
